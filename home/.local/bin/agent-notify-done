#!/usr/bin/env bash
set -uo pipefail

agent_name="${1:-Agent}"
repo_name=$(basename "${PWD:-$(pwd)}")
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "detached")
title="$agent_name finished turn"
body="Repository: $repo_name ($branch)"

# 1. Herdr in-app notification & audio chime
if command -v herdr >/dev/null 2>&1 && [ -n "${HERDR_SOCKET_PATH:-}" ]; then
  herdr notification show "$title" --body "$body" --sound done 2>/dev/null || true
fi

# 2. OS Desktop Toast (Windows toast popup disabled; macOS/Linux only)
if [ "$(uname -s)" = "Darwin" ]; then
  # macOS native notification
  osascript -e "display notification \"$body\" with title \"$title\" sound name \"Glass\"" 2>/dev/null || true
elif ! grep -qi microsoft /proc/version 2>/dev/null && command -v notify-send >/dev/null 2>&1; then
  notify-send "$title" "$body" 2>/dev/null || true
fi
