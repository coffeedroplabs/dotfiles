# DeepSeek API key for the deepseek-executor MCP server and claude-deepseek.
# Copy to .env (gitignored) and chmod 600 it. Get a key at https://platform.deepseek.com
# Privacy: per DeepSeek's privacy policy, the first-party API may use inputs for training
# and stores data in the PRC; opting out of training is done by email.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional overrides, read from the environment rather than this file:
#   DEEPSEEK_MODEL     default deepseek-flash
#   DEEPSEEK_BASE_URL  default https://api.deepseek.com (executor only)
