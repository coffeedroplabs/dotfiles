{
  "herdr": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash '$HOME/.gemini/hooks/herdr-agent-state.sh' session",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agent-notify-done 'Antigravity'",
        "timeout": 5
      }
    ]
  }
}
